NODE_ENV=development

PORT=5000

APP_NAME=Contractor Worker Management System

API_PREFIX=/api/v1

MONGODB_URI=

JWT_SECRET=

JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=

JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

CLIENT_URL=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

LOG_LEVEL=debug

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=200

